# ============================================================
# CodeForge AI — Production Environment Variables
# Copy this file to '.env' and fill in your secrets before deploying
# ============================================================

# Database Configuration
POSTGRES_DB=codeforge
POSTGRES_USER=codeforge
POSTGRES_PASSWORD=your_strong_postgres_password_here

# MinIO / Object Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_strong_minio_password_here
MINIO_BUCKET=codeforge-repos

# JWT Security Secret (must match across services, min 256 bits)
JWT_SECRET=codeforge-ai-super-secret-jwt-key-256-bits-long-change-in-prod

# External API Keys
GITHUB_TOKEN=ghp_your_github_personal_access_token
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here

# Qdrant Vector Database (Cloud instance)
QDRANT_URL=https://c220b29b-e47c-4555-a3f7-e729134e8be9.eu-west-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key

# Gateway Exposed Host Port
GATEWAY_PORT=8085
